    "adapted_in_archive": false,
    "material_policy": "source_faithful_experimental_content_with_standardized_simulation_wrapper",
    "authorized_normalizations": [
      "Corrected the archive's automatic source mapping to Hershcovis and Bhatnagar (2017), Study 3.",
      "Removed reason generation and tip steering.",
      "Locked employee-support items 3-6 as primary; retained customer treatment, award, and tip as secondary."
