    "primary_outcome": "negative_group_reaction",
    "primary_estimand": "[E(Y|low effort,traditional)-E(Y|low ability,traditional)]-[E(Y|low effort,reversed)-E(Y|low ability,reversed)]"
  },
  "population": {
    "source_population": "Adult task-group participants",
    "simulation_target": "Task-group member evaluating a poor performer",
    "claims_population_representativeness": false,
    "required_persona_fields": [
      "participant_id",
      "adult"
    ]
  },
  "materials": {
    "participant_role": "Act as one member of the task group. Evaluate the poor-performing member for yourself and do not analyze the experiment.",
    "common_scenario": "A fellow group member performs poorly. Information about effort, ability, and the reason for the shortfall follows.",
    "arms": {
      "low_effort_traditional": {
        "label": "Low Effort Traditional",
        "stimulus": "The member has high ability but expends little effort because they do not care about the group task."
      },
      "low_effort_reversed": {
        "label": "Low Effort Reversed",
        "stimulus": "The member has high ability but expends little effort because they believe they lack the capacity to succeed, not because they do not care."
      },
      "low_ability_traditional": {
        "label": "Low Ability Traditional",
        "stimulus": "The member works hard but lacks the required knowledge because they never had the opportunity to acquire it."
      },
      "low_ability_reversed": {
        "label": "Low Ability Reversed",
        "stimulus": "The member works hard but lacks the required knowledge because they chose not to acquire it."
      }
    },
    "response_instruction": "Rate all items from 1 to 5 and return only integer responses."
  },
  "outcomes": {
    "negative_group_reaction": {
      "role": "primary",
      "type": "composite_mean",
      "items": [
        {
          "item_id": "reaction_1",
          "text": "I would threaten punishment if the member does not work hard.",
          "minimum": 1,
          "maximum": 5,
          "integer_only": true,
          "reverse_scored": false
        },
        {
          "item_id": "reaction_2",
          "text": "I would convince the member that they can perform well.",
          "minimum": 1,
          "maximum": 5,
          "integer_only": true,
          "reverse_scored": true
        },
        {
          "item_id": "reaction_3",
          "text": "I would remove the member from the team.",
          "minimum": 1,
          "maximum": 5,
          "integer_only": true,
          "reverse_scored": false
        },
        {
          "item_id": "reaction_4",
          "text": "I would offer the member a training opportunity.",
          "minimum": 1,
          "maximum": 5,
          "integer_only": true,
          "reverse_scored": true
        },
        {
          "item_id": "reaction_5",
          "text": "I would threaten punishment if the member does not obtain training.",
          "minimum": 1,
          "maximum": 5,
          "integer_only": true,
          "reverse_scored": false
        }
      ],
      "aggregation": "mean",
      "model_may_write_aggregate": false
