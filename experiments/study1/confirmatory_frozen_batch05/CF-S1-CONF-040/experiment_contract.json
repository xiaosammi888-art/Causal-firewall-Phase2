  "materials": {
    "participant_role": "Act as one member of the task group. Evaluate the poor-performing member for yourself and do not analyze the experiment.",
    "common_scenario": "A group member performs poorly. Their effort, ability, and inferred reason are described below.",
    "arms": {
      "low_effort_traditional": {
        "label": "Low Effort Traditional",
        "stimulus": "The member has adequate ability but gives low effort because they do not care about the group."
      },
      "low_effort_reversed": {
        "label": "Low Effort Reversed",
        "stimulus": "The member has adequate ability but gives low effort because they believe they lack capacity, not because they do not care."
      },
      "low_ability_traditional": {
        "label": "Low Ability Traditional",
        "stimulus": "The member gives high effort but lacks skills because of limited opportunity, not lack of care."
      },
      "low_ability_reversed": {
        "label": "Low Ability Reversed",
        "stimulus": "The member gives high effort but lacks skills because they chose not to acquire them and do not care."
      }
    },
    "response_instruction": "Rate items 1-11 and 13-15 from 1 to 5; attribution choice item 12 uses 1-4. Return only integer responses."
  },
